<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_tb_testing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.34.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.7.0">
  <bpmn:collaboration id="Collaboration_tb_testing">
    <bpmn:participant id="Participant_tb" name="Тестирование по ТБ — допуск к нарядам ВФМ" processRef="Process_tb_testing" />
    <bpmn:textAnnotation id="TextAnnotation_1v5pq1p">
      <bpmn:text>ТБ - техника безопасности</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1j5li2u" associationDirection="None" sourceRef="Task_show_test_screen" targetRef="TextAnnotation_1v5pq1p" />
  </bpmn:collaboration>
  <bpmn:process id="Process_tb_testing" isExecutable="true">
    <bpmn:laneSet id="LaneSet_tb">
      <bpmn:lane id="Lane_system" name="Система">
        <bpmn:flowNodeRef>StartEvent_midnight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_lock_wfm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_generate_json</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_save_json</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_unlock_wfm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_installer" name="Инсталлятор">
        <bpmn:flowNodeRef>Task_show_test_screen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1xodl56</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_start_test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_answer_questions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_submit_test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_retry_test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_test_passed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_access_wfm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0vh5juu</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_engineer" name="Инженер">
        <bpmn:flowNodeRef>Task_review_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_approve_installer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_receive_notification</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_midnight" name="00:00 — начало нового дня">
      <bpmn:outgoing>Flow_midnight_to_lock</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_midnight">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 0 0 * * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_lock_wfm" name="Заблокировать наряды ВФМ для всех инсталляторов">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="wfm:lock-work-orders" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_midnight_to_lock</bpmn:incoming>
      <bpmn:outgoing>Flow_lock_to_screen</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_midnight_to_lock" sourceRef="StartEvent_midnight" targetRef="Task_lock_wfm" />
    <bpmn:sequenceFlow id="Flow_lock_to_screen" sourceRef="Task_lock_wfm" targetRef="Task_show_test_screen" />
    <bpmn:sequenceFlow id="Flow_start_to_questions" sourceRef="Task_start_test" targetRef="Task_answer_questions" />
    <bpmn:sequenceFlow id="Flow_questions_to_submit" sourceRef="Task_answer_questions" targetRef="Task_submit_test" />
    <bpmn:sequenceFlow id="Flow_submit_to_gateway" sourceRef="Task_submit_test" targetRef="Gateway_test_passed" />
    <bpmn:sequenceFlow id="Flow_passed_yes" name="Да — порог набран" sourceRef="Gateway_test_passed" targetRef="Task_receive_notification" />
    <bpmn:sequenceFlow id="Flow_retry_to_start" sourceRef="Task_retry_test" targetRef="Gateway_1xodl56" />
    <bpmn:sequenceFlow id="Flow_notif_to_review" sourceRef="Task_receive_notification" targetRef="Task_review_result" />
    <bpmn:sequenceFlow id="Flow_review_to_approve" sourceRef="Task_review_result" targetRef="Task_approve_installer" />
    <bpmn:sequenceFlow id="Flow_approve_to_gen_json" sourceRef="Task_approve_installer" targetRef="Task_generate_json" />
    <bpmn:sequenceFlow id="Flow_approve_to_unlock_trigger" sourceRef="Task_wait_engineer_approval" targetRef="Task_wait_engineer_approval" />
    <bpmn:sequenceFlow id="Flow_unlock_to_wfm" sourceRef="Task_unlock_wfm" targetRef="Task_access_wfm" />
    <bpmn:sequenceFlow id="Flow_wfm_to_end" sourceRef="Task_access_wfm" targetRef="EndEvent_done" />
    <bpmn:sequenceFlow id="Flow_144rneq" sourceRef="Gateway_1xodl56" targetRef="Task_start_test" />
    <bpmn:sequenceFlow id="Flow_1xm5jr4" sourceRef="Task_show_test_screen" targetRef="Gateway_1xodl56" />
    <bpmn:sequenceFlow id="Flow_11r7ie0" name="Нет" sourceRef="Gateway_test_passed" targetRef="Task_retry_test" />
    <bpmn:sequenceFlow id="Flow_1rinxnr" sourceRef="Task_generate_json" targetRef="Task_save_json" />
    <bpmn:sequenceFlow id="Flow_087h13u" sourceRef="Task_save_json" targetRef="Task_unlock_wfm" />
    <bpmn:userTask id="Task_show_test_screen" name="Отобразить экран тестирования по ТБ">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:ioMapping>
          <zeebe:output source="=previousTestResult" target="previousTestResult" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_lock_to_screen</bpmn:incoming>
      <bpmn:outgoing>Flow_1xm5jr4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1xodl56">
      <bpmn:incoming>Flow_retry_to_start</bpmn:incoming>
      <bpmn:incoming>Flow_1xm5jr4</bpmn:incoming>
      <bpmn:outgoing>Flow_144rneq</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_start_test" name="Нажать кнопку «Начать тест»">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_144rneq</bpmn:incoming>
      <bpmn:outgoing>Flow_start_to_questions</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_answer_questions" name="Отвечать на вопросы теста (с таймером)">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:ioMapping>
          <zeebe:output source="=answers" target="testAnswers" />
          <zeebe:output source="=elapsedTime" target="testDuration" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_questions</bpmn:incoming>
      <bpmn:outgoing>Flow_questions_to_submit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Event_0vh5juu" name="30 минут" attachedToRef="Task_answer_questions">
      <bpmn:outgoing>Flow_17ubbr1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0m7clk2" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_submit_test" name="Нажать кнопку «Сдать тест»">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_questions_to_submit</bpmn:incoming>
      <bpmn:outgoing>Flow_submit_to_gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_17ubbr1" sourceRef="Event_0vh5juu" targetRef="Task_retry_test" />
    <bpmn:userTask id="Task_retry_test" name="Уведомление: тест не пройден. Повторить попытку">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11r7ie0</bpmn:incoming>
      <bpmn:incoming>Flow_17ubbr1</bpmn:incoming>
      <bpmn:outgoing>Flow_retry_to_start</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_test_passed" name="Тест пройден успешно?">
      <bpmn:incoming>Flow_submit_to_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_passed_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_11r7ie0</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_review_result" name="Просмотреть результаты теста инсталлятора">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_notif_to_review</bpmn:incoming>
      <bpmn:outgoing>Flow_review_to_approve</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_approve_installer" name="Нажать кнопку «Подтвердить» инсталлятора">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_review_to_approve</bpmn:incoming>
      <bpmn:outgoing>Flow_approve_to_gen_json</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_generate_json" name="Сформировать JSON наряда допуска (динамические поля: фио подтверждающего и фио инсталлятора — на 1 день)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="permit:generate-json" />
        <zeebe:ioMapping>
          <zeebe:input source="=installerFullName" target="installerFullName" />
          <zeebe:input source="=testScore" target="testScore" />
          <zeebe:input source="=testDuration" target="testDuration" />
          <zeebe:input source="=today()" target="permitDate" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_approve_to_gen_json</bpmn:incoming>
      <bpmn:outgoing>Flow_1rinxnr</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_save_json" name="Сохранить JSON наряда допуска у инсталлятора и у инженера в базе">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="permit:save-json" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1rinxnr</bpmn:incoming>
      <bpmn:outgoing>Flow_087h13u</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_unlock_wfm" name="Разблокировать наряды ВФМ для инсталлятора">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="wfm:unlock-work-orders" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_087h13u</bpmn:incoming>
      <bpmn:outgoing>Flow_unlock_to_wfm</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_access_wfm" name="Открыть наряды ВФМ — доступ разблокирован">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_unlock_to_wfm</bpmn:incoming>
      <bpmn:outgoing>Flow_wfm_to_end</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_done" name="Инсталлятор получил доступ к нарядам ВФМ">
      <bpmn:incoming>Flow_wfm_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_receive_notification" name="Получить уведомление: ФИО, результат, время прохождения теста">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:ioMapping>
          <zeebe:input source="=installerFullName" target="installerFullName" />
          <zeebe:input source="=testScore" target="testScore" />
          <zeebe:input source="=testDuration" target="testDuration" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_passed_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_notif_to_review</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
